  quizTitle: "\u041A\u0432\u0438\u0437 \u0438\u0442\u043E\u0433\u043E\u0432\u044B\u0439"
  questions:
  - questionText: "\u041A\u0430\u043A\u043E\u0432\u043E \u0434\u043E\u043F\u0443\u0441\u0442\u0438\u043C\u043E\u0435
      \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043E\u0442 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u043E\u0433\u043E
      \u0434\u043E\u0437\u0438\u043C\u0435\u0442\u0440\u0430 \u0434\u043E \u0441\u0442\u0435\u043D
      \u043F\u0440\u0438 \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u0438
      \u0441\u043F\u043B\u043E\u0448\u043D\u043E\u0439 \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u043E\u0439
      \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0438 \u0432
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445? "
    answers:
    - "\u041D\u0435 \u0431\u043E\u043B\u0435\u0435 0.3 \u043C\u0435\u0442\u0440\u0430"
    - "\u041D\u0435 \u043C\u0435\u043D\u0435\u0435 0.3 \u043C\u0435\u0442\u0440\u0430"
    - "\u041D\u0435 \u043C\u0435\u043D\u0435\u0435 0.5 \u043C\u0435\u0442\u0440\u0430"
    - "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u043B\u044C\u043D\u043E\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0435"
    correctIndex: 0
  - questionText: "\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u0435
      \u043E\u0442 \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u043F\u043E\u043B\u0430 \u0441\u043B\u0435\u0434\u0443\u0435\u0442 \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
      \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438? "
    answers:
    - "1 \u043C\u0435\u0442\u0440"
    - "0.3 \u043C\u0435\u0442\u0440\u0430"
    - "2 \u043C\u0435\u0442\u0440\u0430"
    - "\u041F\u0440\u043E\u0438\u0437\u0432\u043E\u043B\u044C\u043D\u0430\u044F \u0432\u044B\u0441\u043E\u0442\u0430"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u0438\u0435 \u044D\u0442\u0430\u043F\u044B
      \u0432\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u0432 \u0441\u0435\u0431\u044F
      \u0430\u043B\u0433\u043E\u0440\u0438\u0442\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F
      \u041C\u0410\u042D\u0414 \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445? "
    answers:
    - "\u041F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0430,
      \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0413\u0418 \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0438 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 "
    - "\u0422\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F
      \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0430 "
    - "\u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0413\u0418 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 "
    - "\u041E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u043E\u043C"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u0438\u0435 \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u043F\u043E\u043C\u0438\u043C\u043E
      \u0434\u043E\u0437\u0438\u043C\u0435\u0442\u0440\u0430-\u0440\u0430\u0434\u0438\u043E\u043C\u0435\u0442\u0440\u0430,
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u044B \u0434\u043B\u044F
      \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u0438\u044F \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u043E\u0431\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u043E\u0431\u044A\u0435\u043A\u0442\u0430? "
    answers:
    - "\u0418\u0437\u043C\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u0430\u044F
      \u0440\u0443\u043B\u0435\u0442\u043A\u0430, \u043F\u0440\u0438\u0431\u043E\u0440
      \u0434\u043B\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440\u043E\u0432 \u043C\u0438\u043A\u0440\u043E\u043A\u043B\u0438\u043C\u0430\u0442\u0430 "
    - "\u041F\u0440\u0438\u0431\u043E\u0440\u044B \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u0448\u0443\u043C\u0430 \u0438 \u0432\u0438\u0431\u0440\u0430\u0446\u0438\u0438 "
    - "\u041F\u0440\u0438\u0431\u043E\u0440\u044B \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u0448\u0443\u043C\u0430 \u0438 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u043D\u043E\u0441\u0442\u0438 "
    - "\u041F\u0440\u0438\u0431\u043E\u0440\u044B \u0434\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u0430\u044D\u0440\u043E\u0438\u043E\u043D\u043E\u0432 \u0438 \u043D\u0435\u0438\u043E\u043D\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
      \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u043E\u0439 \u0440\u0430\u0434\u0438\u043E\u043D\u0443\u043A\u043B\u0438\u0434
      \u043F\u0440\u0435\u0438\u043C\u0443\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u043E
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043B\u0441\u044F
      \u0432 \u043B\u044E\u043C\u0438\u043D\u043E\u0444\u043E\u0440\u043D\u044B\u0445
      \u0441\u043E\u0441\u0442\u0430\u0432\u0430\u0445 \u0434\u043B\u044F \u0446\u0438\u0444\u0435\u0440\u0431\u043B\u0430\u0442\u043E\u0432
      \u0438 \u0441\u0442\u0440\u0435\u043B\u043E\u043A \u0447\u0430\u0441\u043E\u0432? "
    answers:
    - "\u0420\u0430\u0434\u0438\u0439-226 "
    - "\u0419\u043E\u0434-131 "
    - "\u0426\u0435\u0437\u0438\u0439-137 "
    - "\u0423\u0440\u0430\u043D-238"
    correctIndex: 1
  - questionText: "\u0414\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u0436\u0438\u043B\u044B\u0445
      \u0437\u0434\u0430\u043D\u0438\u0439 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044C \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F:"
    answers:
    - "\u0412\u043D\u0443\u0442\u0440\u0438 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0439
      \u0438 \u043D\u0430 \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0435\u0439
      \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 (\u0435\u0441\u043B\u0438
      \u0442\u0430\u043A\u043E\u0432\u0430\u044F \u0438\u043C\u0435\u0435\u0442\u0441\u044F) "
    - "\u0418\u0441\u043A\u043B\u044E\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
      \u043D\u0430 \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0435\u0439
      \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438 "
    - "\u0422\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438,
      \u043D\u0435 \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0435\u0439
      \u043A \u0437\u0434\u0430\u043D\u0438\u044E "
    - "\u041D\u0430 \u043A\u0440\u044B\u0448\u0435 \u0437\u0434\u0430\u043D\u0438\u044F"
    correctIndex: 0
  - questionText: "\u0414\u043B\u044F \u0447\u0435\u0433\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044E\u0442\u0441\u044F
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u041C\u0410\u042D\u0414 \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438? "
    answers:
    - "\u0414\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
      \u041C\u0410\u042D\u0414 \u0413\u0418 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
      \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u0430\u043C"
    - "\u0414\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
      \u043F\u0440\u0438\u043B\u0435\u0433\u0430\u044E\u0449\u0435\u0439 \u0442\u0435\u0440\u0440\u0438\u0442\u043E\u0440\u0438\u0438
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
      \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u0430\u043C "
    - "\u0414\u043B\u044F \u043E\u0446\u0435\u043D\u043A\u0438 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u044F
      \u043F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u0438 \u043F\u043E\u0442\u043E\u043A\u0430
      \u0431\u0435\u0442\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u043C
      \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u0430\u043C "
    - "\u0414\u043B\u044F \u0440\u0430\u0441\u0447\u0435\u0442\u0430 \u0441\u043E\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F
      \u0434\u043E\u0447\u0435\u0440\u043D\u0438\u0445 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u043E\u0432
      \u0440\u0430\u0441\u043F\u0430\u0434\u0430 \u0440\u0430\u0434\u043E\u043D\u0430"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u043E\u0439 \u043F\u0430\u0440\u0430\u043C\u0435\u0442\u0440
      \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432 \u0435\u0434\u0438\u043D\u0438\u0446\u0430\u0445
      \u043C\u043A\u0417\u0432/\u0447? "
    answers:
    - "\u041C\u0410\u042D\u0414 \u0413\u0418 "
    - "\u0410\u043C\u0431\u0438\u0435\u043D\u0442\u043D\u044B\u0439 \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442
      \u0434\u043E\u0437\u044B \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u041F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043A\u0430
      \u0431\u0435\u0442\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u042D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0434\u043E\u0437\u0430"
    correctIndex: 0
  - questionText: "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u041C\u0410\u042D\u0414
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438
      \u0438 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445
      \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F"
    answers:
    - "\u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0441\u0440\u0435\u0434\u0441\u0442\u0432
      \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u043E\u0434\u043D\u043E\u0433\u043E
      \u0442\u0438\u043F\u0430 "
    - "\u0421 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
      \u0440\u0430\u0437\u043B\u0438\u0447\u043D\u044B\u0445 \u043F\u0440\u0438\u0431\u043E\u0440\u043E\u0432"
    correctIndex: 0
  - questionText: "\u0413\u0434\u0435 \u0444\u0438\u043A\u0441\u0438\u0440\u0443\u0435\u0442\u0441\u044F
      \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F \u043E \u043F\u043E\u0432\u0435\u0440\u043A\u0435
      \u0438\u0437\u043C\u0435\u0440\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0433\u043E
      \u043F\u0440\u0438\u0431\u043E\u0440\u0430? "
    answers:
    - "\u0412 \u0441\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u0435
      \u043E \u043F\u043E\u0432\u0435\u0440\u043A\u0435 "
    - "\u0412 \u0442\u0435\u0445\u043D\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u043F\u0430\u0441\u043F\u043E\u0440\u0442\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u0430 "
    - "\u0412 \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043D\u043E\u043C
      \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442\u0435 \u0421\u0430\u043D\u041F\u0438\u041D
      2.6.1.2523-09 "
    - "\u0412 \u0424\u0417 \"\u041E \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F\"
      \u043E\u0442 09.01.1996 N 3-\u0424\u0417"
    correctIndex: 0
  - questionText: "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u041C\u0410\u042D\u0414
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439 \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438,
      \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u043C\u044B\u0435 \u0434\u043B\u044F
      \u043E\u0446\u0435\u043D\u043A\u0438 \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u043E\u0431\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438 \u0432 \u0436\u0438\u043B\u044B\u0445
      \u0437\u0434\u0430\u043D\u0438\u044F\u0445, \u0441\u043B\u0435\u0434\u0443\u0435\u0442
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u044C"
    answers:
    - "\u0412 \u0447\u0435\u0442\u044B\u0440\u0435\u0445 \u0442\u043E\u0447\u043A\u0430\u0445,
      \u0441 \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
      \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435 1 \u043C"
    - "\u0412 \u0442\u0440\u0435\u0445 \u0442\u043E\u0447\u043A\u0430\u0445, \u0441
      \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F,
      \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 1 \u043C "
    - "\u0412 \u0447\u0435\u0442\u044B\u0440\u0435\u0445 \u0442\u043E\u0447\u043A\u0430\u0445,
      \u0441 \u0440\u0430\u0437\u043D\u044B\u0445 \u0441\u0442\u043E\u0440\u043E\u043D
      \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435 1,5 \u043C "
    - "\u0412 \u0447\u0435\u0442\u044B\u0440\u0435\u0445 \u0442\u043E\u0447\u043A\u0430\u0445,
      \u0441 \u043E\u0434\u043D\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B
      \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u044F, \u043D\u0430
      \u0432\u044B\u0441\u043E\u0442\u0435 1 \u043C"
    correctIndex: 0
  - questionText: "\u041F\u0440\u0438 \u043F\u0440\u0435\u0432\u044B\u0448\u0435\u043D\u0438\u0438
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u043D\u043E\u0440\u043C\u0430\u0442\u0438\u0432\u043E\u0432 \u041C\u0410\u042D\u0414
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F,
      \u043A\u0430\u043A\u0438\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F
      \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E \u043F\u0440\u0435\u0434\u043F\u0440\u0438\u043D\u044F\u0442\u044C? "
    answers:
    - "\u0410\u043D\u0430\u043B\u0438\u0437 \u043F\u0440\u0438\u0447\u0438\u043D
      \u0438 \u0440\u0435\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u0437\u0430\u0449\u0438\u0442\u043D\u044B\u0445
      \u043C\u0435\u0440\u043E\u043F\u0440\u0438\u044F\u0442\u0438\u0439 "
    - "\u0414\u0435\u043C\u043E\u043D\u0442\u0430\u0436 \u0437\u0434\u0430\u043D\u0438\u044F"
    correctIndex: 0
  - questionText: "\u0427\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439? "
    answers:
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445 \u0440\u0430\u0434\u0438\u043E\u043D\u0443\u043A\u043B\u0438\u0434\u043E\u0432
      \u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445 "
    - "\u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0442\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0445
      \u0440\u0430\u0434\u0438\u043E\u043D\u0443\u043A\u043B\u0438\u0434\u043E\u0432
      \u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445 "
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u0440\u0430\u0434\u043E\u043D\u0430 \u0432 \u043F\u043E\u0447\u0432\u0435 "
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u0442\u043E\u0440\u043E\u043D\u0430 \u0432 \u043F\u043E\u0447\u0432\u0435"
    correctIndex: 0
  - questionText: "\u0427\u0442\u043E \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438\u0447\u0438\u043D\u043E\u0439 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432
      \u0440\u0430\u0434\u0438\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F? "
    answers:
    - "\u041D\u0430\u043B\u0438\u0447\u0438\u0435 \u0442\u0435\u0445\u043D\u043E\u0433\u0435\u043D\u043D\u044B\u0445
      \u0440\u0430\u0434\u0438\u043E\u043D\u0443\u043A\u043B\u0438\u0434\u043E\u0432
      \u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445 "
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u043F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0445 \u0440\u0430\u0434\u0438\u043E\u043D\u0443\u043A\u043B\u0438\u0434\u043E\u0432
      \u0432 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u0430\u0445 "
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u0440\u0430\u0434\u043E\u043D\u0430 \u0432 \u043F\u043E\u0447\u0432\u0435 "
    - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F
      \u0442\u043E\u0440\u043E\u043D\u0430 \u0432 \u043F\u043E\u0447\u0432\u0435"
    correctIndex: 0
  - questionText: "\u0414\u043B\u044F \u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442
      \u0441\u043F\u043B\u043E\u0448\u043D\u0443\u044E \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0443
      \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445 \u0436\u0438\u043B\u044B\u0445
      \u0438 \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
      \u0437\u0434\u0430\u043D\u0438\u0439? "
    answers:
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u043B\u043E\u043A\u0430\u043B\u044C\u043D\u044B\u0445
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445 \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u0439 "
    - "\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u0444\u043E\u043D\u0430 "
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0440\u0430\u0434\u043E\u043D\u0430 "
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0442\u043E\u0440\u043E\u043D\u0430"
    correctIndex: 0
  - questionText: "\u0414\u043B\u044F \u0447\u0435\u0433\u043E \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442
      \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0443 \u0432
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438? "
    answers:
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0443\u0447\u0430\u0441\u0442\u043A\u043E\u0432
      \u0440\u0430\u0434\u0438\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E
      \u0437\u0430\u0433\u0440\u044F\u0437\u043D\u0435\u043D\u0438\u044F "
    - "\u0414\u043B\u044F \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u0444\u043E\u043D\u0430 "
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0440\u0430\u0434\u043E\u043D\u0430 "
    - "\u0414\u043B\u044F \u043F\u043E\u0438\u0441\u043A\u0430 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0430
      \u0442\u043E\u0440\u043E\u043D\u0430"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u043E\u0439 \u0434\u043E\u043A\u0443\u043C\u0435\u043D\u0442
      \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B\u0438\u0440\u0443\u0435\u0442
      \u0438\u0442\u043E\u0433\u0438 \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439? "
    answers:
    - "\u041F\u0440\u043E\u0442\u043E\u043A\u043E\u043B \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439"
    - "\u041B\u0438\u0446\u0435\u043D\u0437\u0438\u044F"
    - "\u0421\u0432\u0438\u0434\u0435\u0442\u0435\u043B\u044C\u0441\u0442\u0432\u043E
      \u043E\u0431 \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u0430\u0446\u0438\u0438 "
    - "\u041C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u043E\u0435 \u0437\u0430\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435"
    correctIndex: 0
  - questionText: "\u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439
      \u0434\u043E\u0437\u044B \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F
      \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438 \u043F\u043E
      \u043E\u0442\u043D\u043E\u0448\u0435\u043D\u0438\u044E \u043A \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438
      \u0434\u043E\u0437\u044B \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
      \u043C\u0435\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u043D\u0435 \u0434\u043E\u043B\u0436\u043D\u0430
      \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0442\u044C: "
    answers:
    - "0,2 \u043C\u043A\u0417\u0432/\u0447 (\u041D\u0420\u0411-99/2009) "
    - "0,2 \u043C\u043A\u0417\u0432/\u0447 (\u0424\u0417 \"\u041E \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E-\u044D\u043F\u0438\u0434\u0435\u043C\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u043C
      \u0431\u043B\u0430\u0433\u043E\u043F\u043E\u043B\u0443\u0447\u0438\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F\"
      \u2116 52-\u0424\u0417) "
    - "0,2 \u043C\u043A\u0417\u0432/\u0447 (\u0424\u0417 \"\u041E \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439
      \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438 \u043D\u0430\u0441\u0435\u043B\u0435\u043D\u0438\u044F\"
      \u2116 3-\u0424\u0417) "
    - "1 \u043C\u043A\u0417\u0432/\u0447"
    correctIndex: 0
  - questionText: "\u041C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u0439
      \u043E\u0431\u044A\u0435\u043C \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F \u0432 \u0438\u043D\u0434\u0438\u0432\u0438\u0434\u0443\u0430\u043B\u044C\u043D\u044B\u0445
      \u0436\u0438\u043B\u044B\u0445 \u0434\u043E\u043C\u0430\u0445 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442\u0441\u044F
      \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u043E\u0431\u0440\u0430\u0437\u043E\u043C: "
    answers:
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432\u043E \u0432\u0441\u0435\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445
      \u0441 \u043F\u043E\u0441\u0442\u043E\u044F\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435\u043C
      \u043B\u044E\u0434\u0435\u0439 "
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u043E\u0434\u043D\u043E\u043C \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438
      \u0441 \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u044B\u043C \u043F\u0440\u0435\u0431\u044B\u0432\u0430\u043D\u0438\u0435\u043C
      \u043B\u044E\u0434\u0435\u0439 "
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0432\u043E\u0434\u044F\u0442\u0441\u044F
      \u0432 \u043B\u044E\u0431\u044B\u0445 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445
      - \u043D\u0430 \u0443\u0441\u043C\u043E\u0442\u0440\u0435\u043D\u0438\u0435
      \u0437\u0430\u043A\u0430\u0437\u0447\u0438\u043A\u0430"
    correctIndex: 0
  - questionText: "\u041E\u0446\u0435\u043D\u043A\u0430 \u0437\u0434\u0430\u043D\u0438\u0439
      \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0438\u0435
      \u0441\u0430\u043D\u0438\u0442\u0430\u0440\u043D\u043E- \u044D\u043F\u0438\u0434\u0435\u043C\u0438\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u043C
      \u0442\u0440\u0435\u0431\u043E\u0432\u0430\u043D\u0438\u044F\u043C \u043A \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u0435\u043B\u044F\u043C
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0439 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u0438
      \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F \u043F\u043E \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0430\u043C
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u043E\u0433\u043E
      \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u044F, \u043F\u0440\u043E\u0432\u0435\u0434\u0435\u043D\u043D\u043E\u0433\u043E: "
    answers:
    - "\u0418\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0435\u0439, \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u0432\u0438\u0434\u044B \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439 "
    - "\u0418\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0435\u0439, \u043D\u0435
      \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043D\u0430 \u0441\u043E\u043E\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E\u0449\u0438\u0435
      \u0432\u0438\u0434\u044B \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439 "
    - "\u0424\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u043C \u043B\u0438\u0446\u043E\u043C "
    - "\u0418\u0441\u043F\u044B\u0442\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0439
      \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u0438\u0435\u0439, \u0430\u043A\u043A\u0440\u0435\u0434\u0438\u0442\u043E\u0432\u0430\u043D\u043D\u043E\u0439
      \u043D\u0430 \u043B\u044E\u0431\u044B\u0435 \u0432\u0438\u0434\u044B \u0438\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0439"
    correctIndex: 0
  - questionText: "\u0412\u0435\u0440\u043E\u044F\u0442\u043D\u044B\u0435 \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u0438
      \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u0438 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F\u0445
      \u0436\u0438\u043B\u044B\u0445 \u0437\u0434\u0430\u043D\u0438\u0439: "
    answers:
    - "\u0420\u0430\u0434\u0438\u043E\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435
      \u043E\u0442\u0445\u043E\u0434\u044B"
    - "\u041F\u0440\u0438\u0440\u043E\u0434\u043D\u044B\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B "
    - "\u0420\u0430\u0434\u0438\u043E\u0438\u0437\u043E\u0442\u043E\u043F\u043D\u044B\u0435
      \u043F\u0440\u0438\u0431\u043E\u0440\u044B "
    - "\u0420\u0435\u043D\u0442\u0433\u0435\u043D\u043E\u0432\u0441\u043A\u0438\u0435
      \u0434\u043E\u0441\u043C\u043E\u0442\u0440\u043E\u0432\u044B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438"
    correctIndex: 1
  - questionText: "\u0421\u043F\u043B\u043E\u0448\u043D\u0430\u044F \u043F\u043E\u0438\u0441\u043A\u043E\u0432\u0430\u044F
      \u0433\u0430\u043C\u043C\u0430-\u0441\u044A\u0435\u043C\u043A\u0430 \u0432
      \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438 - \u044D\u0442\u043E: "
    answers:
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0413\u0418 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F "
    - "\u041F\u0440\u043E\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u043D\u0438\u0435
      \u0437\u0432\u0443\u043A\u043E\u0432\u043E\u0439 \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0430\u0446\u0438\u0438
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0441\u0447\u0435\u0442\u0430
      \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u043E\u0432 \u0432\u0434\u043E\u043B\u044C
      \u0441\u0442\u0435\u043D \u0438 \u043F\u043E\u043B\u0430 "
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0413\u0418 \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043A\u0430\u0436\u0434\u043E\u0439
      \u0441\u0442\u0435\u043D\u044B "
    - "\u0418\u0437\u043C\u0435\u0440\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414
      \u0413\u0418 \u0432 \u0443\u0433\u043B\u0443 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u044F"
    correctIndex: 1
  - questionText: "\u0427\u0442\u043E \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0441 \u0431\u044B\u0442\u043E\u0432\u044B\u043C
      \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u043E\u043C, \u044F\u0432\u043B\u044F\u044E\u0449\u0438\u043C\u0441\u044F
      \u0438\u0441\u0442\u043E\u0447\u043D\u0438\u043A\u043E\u043C \u0438\u043E\u043D\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0435\u0433\u043E
      \u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F? "
    answers:
    - "\u0421\u0434\u0430\u0442\u044C \u0432 \u0413\u0423\u041F \u041C\u041E\u0421\u041D\u041F\u041E
      \u0420\u0410\u0414\u041E\u041D "
    - "\u0412\u044B\u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
      \u0432 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \xAB\u0421\u043C\u0435\u0448\u0430\u043D\u043D\u044B\u0435
      \u043E\u0442\u0445\u043E\u0434\u044B\xBB "
    - "\u0412\u044B\u043D\u0435\u0441\u0442\u0438 \u043D\u0430 \u0443\u043B\u0438\u0446\u0443
      \u0432 \u043A\u043E\u043D\u0442\u0435\u0439\u043D\u0435\u0440 \xAB\u041F\u043B\u0430\u0441\u0442\u0438\u043A\xBB "
    - "\u041F\u043E\u0434\u0430\u0440\u0438\u0442\u044C \u0441\u043E\u0441\u0435\u0434\u0443"
    correctIndex: 0
  - questionText: "\u041A\u0430\u043A\u0430\u044F \u0432\u0435\u043B\u0438\u0447\u0438\u043D\u0430
      \u0438\u0437\u043C\u0435\u0440\u044F\u0435\u0442\u0441\u044F \u0432 \u0441\u043C-2*\u043C\u0438\u043D-1? "
    answers:
    - "\u041F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043A\u0430
      \u0431\u0435\u0442\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u0430\u043C\u0431\u0438\u0435\u043D\u0442\u043D\u043E\u0433\u043E
      \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u0430 \u0434\u043E\u0437\u044B
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u042D\u043A\u0441\u043F\u043E\u0437\u0438\u0446\u0438\u043E\u043D\u043D\u0430\u044F
      \u0434\u043E\u0437\u0430 "
    - "\u042D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u043D\u0430\u044F
      \u0434\u043E\u0437\u0430"
    correctIndex: 1
  - questionText: "\u041C\u0410\u042D\u0414 \u0413\u0418 \u2013 \u044D\u0442\u043E\u2026? "
    answers:
    - "\u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u0430\u043C\u0431\u0438\u0435\u043D\u0442\u043D\u043E\u0433\u043E
      \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442\u0430 \u0434\u043E\u0437\u044B
      \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u041F\u043B\u043E\u0442\u043D\u043E\u0441\u0442\u044C \u043F\u043E\u0442\u043E\u043A\u0430
      \u0431\u0435\u0442\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u0410\u043C\u0431\u0438\u0435\u043D\u0442\u043D\u044B\u0439 \u044D\u043A\u0432\u0438\u0432\u0430\u043B\u0435\u043D\u0442
      \u0434\u043E\u0437\u044B \u0433\u0430\u043C\u043C\u0430-\u0438\u0437\u043B\u0443\u0447\u0435\u043D\u0438\u044F "
    - "\u041C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u044B\u0439 \u0430\u043D\u0430\u043B\u0438\u0437
      \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u043E\u0432 \u0434\u043E\u0437\u0438\u0440\u043E\u0432\u043A\u0438"
    correctIndex: 0
