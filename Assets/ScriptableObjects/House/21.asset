  speakerName: "\u041E\u043B\u0435\u0433"
  text: "\xAB\u041E\u0431\u0440\u0430\u0442\u0438 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435
    \u0440\u0430\u0434\u0438\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0439 \u0444\u043E\u043D
    \u043D\u0430 \u043A\u0443\u0445\u043D\u0435 \u0432\u044B\u0448\u0435, \u0447\u0435\u043C
    \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435. 0,20 \u043C\u0438\u043A\u0440\u043E\u0437\u0438\u0432\u0435\u0442
    \u0432 \u0447\u0430\u0441 - \u044F \u0437\u0430\u043F\u0438\u0441\u0430\u043B
    \u0432 \u043F\u0440\u043E\u0442\u043E\u043A\u043E\u043B. \u0421\u0440\u0435\u0434\u043D\u0435\u0435
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u041C\u0410\u042D\u0414 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043B.
    \u041C\u043E\u0449\u043D\u043E\u0441\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u0434\u043E\u0437\u044B \u043D\u0430 \u043A\u0443\u0445\u043D\u0435 \u0432\u044B\u0448\u0435,
    \u0447\u0435\u043C \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435, \u043D\u043E
    \u043D\u0435 \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u044C
    \u0434\u043E\u0437\u044B \u043D\u0430 \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
